---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/layout/BaseHead.astro';
import Footer from '../components/layout/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/layout/Header.astro';
import PasswordGate from '../components/PasswordGate.astro';
import type { LockedPayload } from '../utils/postLock';

type Props = Omit<CollectionEntry<'blog'>['data'], 'password'> & {
	categoryLabel: string;
	categoryHref: string;
	/** Present when the post is password-protected — see postLock.ts. */
	locked?: LockedPayload;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	categoryLabel,
	categoryHref,
	locked,
} = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="post-main">
			<article>
				{
					heroImage && (
						<div class="hero-banner">
							<Image class="hero-banner-img" src={heroImage} alt={title} />
							<div class="hero-banner-scrim" />
							<div class="hero-banner-content">
								<div class="hero-banner-inner">
									<a class="hero-category" href={categoryHref}>{categoryLabel}</a>
									<h1 class="hero-title">{title}</h1>
									<FormattedDate date={pubDate} />
								</div>
							</div>
						</div>
					)
				}

				<div class={`post-body${heroImage ? '' : ' post-body-top'}`}>
					<header class="post-header">
						{
							!heroImage && (
								<div class="post-meta">
									<a class="post-category" href={categoryHref}>{categoryLabel}</a>
									<FormattedDate date={pubDate} />
								</div>
							)
						}

						{!heroImage && <h1>{title}</h1>}

						<p class="post-description">{description}</p>

						{
							updatedDate && (
								<p class="last-updated-on">
									최종 수정: <FormattedDate date={updatedDate} />
								</p>
							)
						}
					</header>

					{
						locked ? (
							<>
								<PasswordGate payload={locked} />
								<div class="prose" id="post-gate-content" hidden />
							</>
						) : (
							<div class="prose">
								<slot />
							</div>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-main {
		width: 100%;
		padding: 0 0 var(--space-16);
	}

	.post-body {
		width: min(100% - 3rem, var(--reading-width));
		margin: 0 auto;
	}

	.post-body-top {
		padding-top: var(--space-16);
	}

	.hero-banner {
		position: relative;
		width: 100%;
		height: clamp(220px, 38vw, 420px);
		margin: 0 0 var(--space-8);
		overflow: hidden;
	}

	.hero-banner-img {
		display: block;
		width: 100%;
		height: 100%;
		margin: 0;
		border-radius: 0;
		object-fit: cover;
	}

	.hero-banner-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(10, 10, 20, 0.4) 0%,
			rgba(10, 10, 20, 0.45) 50%,
			rgba(10, 10, 20, 0.6) 100%
		);
	}

	.hero-banner-content {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(1.5rem, 4vw, 2.5rem);
	}

	.hero-banner-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		max-width: 40rem;
		color: rgba(255, 255, 255, 0.85);
		font-size: 0.85rem;
		text-align: center;
	}

	.hero-category {
		border-radius: var(--radius-full);
		background: rgba(255, 255, 255, 0.16);
		backdrop-filter: blur(6px);
		color: #ffffff;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-decoration: none;
		padding: 0.35rem 0.85rem;
	}

	.hero-category:hover {
		background: rgba(255, 255, 255, 0.28);
	}

	.hero-title {
		margin: 0;
		color: #ffffff;
		font-size: clamp(1.6rem, 3.6vw, 2.4rem);
		line-height: 1.3;
		word-break: keep-all;
	}

	.post-header {
		border-bottom: 1px solid var(--line);
		padding-bottom: var(--space-6);
		margin-bottom: var(--space-8);
	}

	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 0.9rem;
		color: var(--muted);
		font-size: 0.82rem;
	}

	.post-category {
		color: var(--accent);
		font-weight: 700;
		text-decoration: none;
	}

	.post-category:hover {
		text-decoration: underline;
	}

	.post-header h1 {
		margin: 0;
		font-size: clamp(1.9rem, 3.6vw, 2.75rem);
		letter-spacing: -0.045em;
		line-height: 1.25;
		word-break: keep-all;
		overflow-wrap: break-word;
	}

	.post-description {
		max-width: 38rem;
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.75;
		word-break: keep-all;
	}

	.last-updated-on {
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-size: 0.85rem;
		font-style: italic;
	}

	.prose {
		color: var(--text);
	}

	.prose :global(h2) {
		margin-top: var(--space-12);
		font-size: clamp(1.4rem, 2.4vw, 1.85rem);
		word-break: keep-all;
	}

	.prose :global(h3) {
		margin-top: var(--space-8);
		font-size: clamp(1.15rem, 2vw, 1.4rem);
		word-break: keep-all;
	}

	.prose :global(img) {
		margin: var(--space-6) auto;
	}

	.prose :global(figure) {
		margin: var(--space-6) 0;
	}

	.prose :global(figcaption) {
		margin-top: 0.6rem;
		color: var(--muted);
		font-size: 0.85rem;
		text-align: center;
	}

	/* Display math can overflow on narrow screens — let it scroll on its own. */
	.prose :global(.katex-display) {
		overflow-x: auto;
		overflow-y: hidden;
		padding: 0.5rem 0;
	}

	@media (max-width: 720px) {
		.post-main {
			padding: 0 0 var(--space-12);
		}

		.post-body-top {
			padding-top: var(--space-12);
		}

		.post-body {
			width: min(100% - 2rem, var(--reading-width));
		}

		.hero-banner {
			height: 62vw;
		}
	}
</style>
