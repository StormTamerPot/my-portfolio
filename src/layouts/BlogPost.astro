---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/layout/BaseHead.astro';
import Footer from '../components/layout/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/layout/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	categoryLabel: string;
	categoryHref: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	categoryLabel,
	categoryHref,
} = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="post-main">
			<article>
				<header class="post-header">
					<div class="post-meta">
						<a class="post-category" href={categoryHref}>{categoryLabel}</a>
						<FormattedDate date={pubDate} />
					</div>

					<h1>{title}</h1>

					<p class="post-description">{description}</p>

					{
						updatedDate && (
							<p class="last-updated-on">
								최종 수정: <FormattedDate date={updatedDate} />
							</p>
						)
					}
				</header>

				{
					heroImage && (
						<div class="hero-image">
							<Image src={heroImage} alt="" />
						</div>
					)
				}

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-main {
		width: min(100% - 3rem, var(--reading-width));
		margin: 0 auto;
		padding: var(--space-16) 0;
	}

	.post-header {
		border-bottom: 1px solid var(--line);
		padding-bottom: var(--space-6);
		margin-bottom: var(--space-8);
	}

	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 0.9rem;
		color: var(--muted);
		font-size: 0.82rem;
	}

	.post-category {
		color: var(--accent);
		font-weight: 700;
		text-decoration: none;
	}

	.post-category:hover {
		text-decoration: underline;
	}

	.post-header h1 {
		margin: 0;
		font-size: clamp(1.9rem, 3.6vw, 2.75rem);
		letter-spacing: -0.045em;
		line-height: 1.25;
		word-break: keep-all;
		overflow-wrap: break-word;
	}

	.post-description {
		max-width: 38rem;
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.75;
		word-break: keep-all;
	}

	.last-updated-on {
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-size: 0.85rem;
		font-style: italic;
	}

	.hero-image {
		width: 100%;
		margin-bottom: var(--space-8);
	}

	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-md);
	}

	.prose {
		color: var(--text);
	}

	.prose :global(h2) {
		margin-top: var(--space-12);
		font-size: clamp(1.4rem, 2.4vw, 1.85rem);
		word-break: keep-all;
	}

	.prose :global(h3) {
		margin-top: var(--space-8);
		font-size: clamp(1.15rem, 2vw, 1.4rem);
		word-break: keep-all;
	}

	.prose :global(img) {
		margin: var(--space-6) auto;
	}

	.prose :global(figure) {
		margin: var(--space-6) 0;
	}

	.prose :global(figcaption) {
		margin-top: 0.6rem;
		color: var(--muted);
		font-size: 0.85rem;
		text-align: center;
	}

	/* Display math can overflow on narrow screens — let it scroll on its own. */
	.prose :global(.katex-display) {
		overflow-x: auto;
		overflow-y: hidden;
		padding: 0.5rem 0;
	}

	@media (max-width: 720px) {
		.post-main {
			width: min(100% - 2rem, var(--reading-width));
			padding: var(--space-12) 0;
		}
	}
</style>
