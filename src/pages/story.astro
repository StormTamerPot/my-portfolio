---
import BaseHead from '../components/layout/BaseHead.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { SITE_CONFIG } from '../config/site';
import { getAllTags } from '../utils/blog';

const { profile, links } = SITE_CONFIG;

const focusAreas = SITE_CONFIG.blogCategories.filter(
  (category) => category.id !== 'all',
);

const tags = await getAllTags();
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead
      title={`Story | ${SITE_CONFIG.site.title}`}
      description={`${profile.name}의 연구 관심사와 배경을 소개합니다.`}
    />
  </head>

  <body>
    <Header />

    <main class="bio-main">
      <header class="bio-header">
        <p class="bio-kicker">STORY</p>
        <h1>{profile.name}</h1>
        <p class="bio-role">{profile.role}</p>
      </header>

      <section class="bio-section">
        {
          profile.description.map((paragraph) => (
            <p class="bio-paragraph">{paragraph}</p>
          ))
        }
      </section>

      <section class="bio-section">
        <p class="bio-label">RESEARCH FOCUS</p>

        <div class="focus-grid">
          {
            focusAreas.map((area) => (
              <div class="focus-item">
                <h3>{area.label}</h3>
                <p>{area.description}</p>
              </div>
            ))
          }
        </div>
      </section>

      {
        tags.length > 0 && (
          <section class="bio-section">
            <p class="bio-label">INTERESTS & TOOLS</p>

            <div class="tag-cloud">
              {tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </section>
        )
      }

      <section class="bio-section bio-contact">
        <a class="contact-pill" href={links.github} target="_blank" rel="noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <a class="contact-pill" href={`mailto:${profile.email}`}>{profile.email}</a>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .bio-main {
    width: min(100% - 3rem, var(--reading-width));
    margin: 0 auto;
    padding: var(--space-16) 0;
  }

  .bio-header {
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-8);
  }

  .bio-kicker {
    margin: 0 0 0.9rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .bio-header h1 {
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 3.75rem);
    letter-spacing: -0.06em;
  }

  .bio-role {
    margin: 0.75rem 0 0;
    color: var(--text-secondary);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .bio-section {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--line);
  }

  .bio-section:first-of-type {
    padding-top: 0;
    border-top: none;
  }

  .bio-paragraph {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .bio-label {
    margin: 0 0 1.5rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 2rem;
  }

  .focus-item h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .focus-item p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .tag-cloud span {
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.82rem;
    padding: 0.45rem 0.85rem;
  }

  .bio-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  @media (max-width: 720px) {
    .bio-main {
      width: min(100% - 2rem, var(--reading-width));
      padding: var(--space-12) 0;
    }

    .focus-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
