---
import BlogListing from '../../../layouts/BlogListing.astro';
import { BLOG_CATEGORY_IDS, SITE_CONFIG } from '../../../config/site';
import { getBlogPosts } from '../../../utils/blog';

export async function getStaticPaths() {
  return BLOG_CATEGORY_IDS.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;

const currentCategory = SITE_CONFIG.blogCategories.find(
  (item) => item.id === category,
);

const allPosts = await getBlogPosts();
const posts = allPosts.filter((post) => post.category === category);
---

<BlogListing
  pageTitle={`${currentCategory?.label} | Notes | ${SITE_CONFIG.site.title}`}
  pageDescription={currentCategory?.description ?? ''}
  kicker="NOTES"
  heading={currentCategory?.label ?? ''}
  description={currentCategory?.description}
  sidebarPosts={allPosts}
  activeCategory={category}
  listPosts={posts}
  emptyMessage="아직 이 카테고리에 작성된 글이 없습니다."
/>
