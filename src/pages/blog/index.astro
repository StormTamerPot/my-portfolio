---
import BlogListing from '../../layouts/BlogListing.astro';
import { SITE_CONFIG } from '../../config/site';
import { getBlogPosts } from '../../utils/blog';

const posts = await getBlogPosts();

const allCategory = SITE_CONFIG.blogCategories.find(
  (category) => category.id === 'all',
);
---

<BlogListing
  pageTitle={`Notes | ${SITE_CONFIG.site.title}`}
  pageDescription="Robot Manipulation, VLA, Robotics 연구와 학습 기록입니다."
  kicker="ALL POSTS"
  heading="Notes"
  description={allCategory?.description}
  sidebarPosts={posts}
  activeCategory="all"
  listPosts={posts}
/>
