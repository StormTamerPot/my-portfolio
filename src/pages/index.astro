---
import BaseHead from '../components/layout/BaseHead.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { SITE_CONFIG } from '../config/site';
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={SITE_CONFIG.site.title} description={SITE_CONFIG.site.description} />
  </head>

  <body>
    <Header />

    <main class="home-main">
      <ProfileCard />

      <section class="more-links">
        <a class="text-link" href="/story">
          My story <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href="/blog">
          Notes <span aria-hidden="true">→</span>
        </a>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .home-main {
    width: min(100% - 4rem, var(--page-width));
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0;
  }

  .more-links {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    border-top: 1px solid var(--line);
    padding: clamp(2rem, 4vw, 2.75rem) 0 clamp(3.5rem, 7vw, 5rem);
  }

  .text-link {
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .text-link span {
    margin-left: 0.35rem;
    color: var(--muted);
  }

  .text-link:hover {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .home-main {
      width: min(100% - 2rem, var(--page-width));
    }
  }
</style>
