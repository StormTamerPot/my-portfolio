---
import BaseHead from '../components/layout/BaseHead.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { SITE_CONFIG } from '../config/site';
import { getBlogPosts, getExcerpt } from '../utils/blog';
import { formatDate } from '../utils/formatDate';

const posts = await getBlogPosts();

// Featured projects are blog posts with `featured: true`, newest first.
const featuredProjects = posts.filter((post) => post.entry.data.featured);
const recentPosts = posts.slice(0, 3);
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={SITE_CONFIG.site.title} description={SITE_CONFIG.site.description} />
  </head>

  <body>
    <Header />

    <main class="home-main">
      <ProfileCard />

      <section class="projects-section section">
        <div class="section-heading">
          <div>
            <p class="section-label">SELECTED WORK</p>
            <h2>Featured projects</h2>
          </div>
        </div>

        <div class="project-list">
          {
            featuredProjects.map((project, index) => (
              <a class="project-item" href={project.href}>
                <span class="project-number">
                  {String(index + 1).padStart(2, '0')}
                </span>

                <div class="project-main">
                  <h3>{project.entry.data.title}</h3>
                  <p>{getExcerpt(project)}</p>
                </div>

                <div class="project-meta">
                  <div class="tag-list">
                    {project.entry.data.tags.map((tag) => <span>{tag}</span>)}
                  </div>
                  <span class="project-arrow" aria-hidden="true">↗</span>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="notes-section section">
        <div class="section-heading">
          <div>
            <p class="section-label">RECENT NOTES</p>
            <h2>Writing & notes</h2>
          </div>

          <a class="text-link" href="/blog">
            Read all notes <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="post-grid">
          {
            recentPosts.map((post) => (
              <article class="post-card">
                <p class="post-date">{formatDate(post.entry.data.pubDate)}</p>
                <h3>
                  <a href={post.href}>{post.entry.data.title}</a>
                </h3>
                <p class="post-description">{post.entry.data.description}</p>
                <a class="post-link" href={post.href}>
                  Read note <span aria-hidden="true">→</span>
                </a>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .home-main {
    width: min(100% - 4rem, var(--page-width));
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0;
  }

  .section {
    border-top: 1px solid var(--line);
    padding: clamp(3.5rem, 7vw, 5.5rem) 0;
  }

  .section-label {
    margin: 0;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    margin: 0.7rem 0 0;
    font-size: clamp(2.3rem, 4vw, 3.6rem);
  }

  .text-link {
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .text-link span {
    margin-left: 0.35rem;
    color: var(--accent);
  }

  .text-link:hover {
    color: var(--accent);
  }

  .project-list {
    border-top: 1px solid var(--line);
  }

  .project-item {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    border-bottom: 1px solid var(--line);
    color: inherit;
    padding: 1.45rem 0;
    text-decoration: none;
    transition: padding 180ms ease, background 180ms ease;
  }

  .project-item:hover {
    background: var(--surface-muted);
    padding-right: 1rem;
    padding-left: 1rem;
  }

  /* The section itself already opens with a border-top, so the last row
     shouldn't add its own border-bottom — that doubled up into an empty-
     looking gap between sections. */
  .project-item:last-child {
    border-bottom: none;
  }

  .project-number {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .project-main h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    letter-spacing: -0.04em;
  }

  .project-main p {
    max-width: 37rem;
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .tag-list {
    display: flex;
    max-width: 16rem;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem;
  }

  .tag-list span {
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.7rem;
    padding: 0.35rem 0.55rem;
  }

  .project-arrow {
    color: var(--accent);
    font-size: 1.3rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .post-card {
    display: flex;
    min-height: 14rem;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 1.4rem;
    transition: box-shadow 180ms ease, transform 180ms ease;
  }

  .post-card:hover {
    box-shadow: 0 1rem 2.5rem rgba(30, 43, 68, 0.08);
    transform: translateY(-0.2rem);
  }

  .post-date {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .post-card h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.25rem;
    letter-spacing: -0.035em;
    line-height: 1.35;
  }

  .post-card h3 a {
    color: var(--text);
    text-decoration: none;
  }

  .post-card h3 a:hover {
    color: var(--accent);
  }

  .post-description {
    margin: 0.85rem 0 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .post-link {
    margin-top: auto;
    color: var(--accent);
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .home-main {
      width: min(100% - 2rem, var(--page-width));
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .project-item {
      grid-template-columns: 2.5rem 1fr;
      align-items: start;
      gap: 1rem;
    }

    .project-meta {
      grid-column: 2;
      align-items: flex-start;
      justify-content: space-between;
    }

    .tag-list {
      max-width: none;
      justify-content: flex-start;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }

    .post-card {
      min-height: 13rem;
    }
  }
</style>
