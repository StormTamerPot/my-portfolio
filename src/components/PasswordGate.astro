---
import { PBKDF2_ITERATIONS, type LockedPayload } from '../utils/postLock';

interface Props {
  payload: LockedPayload;
}

const { payload } = Astro.props;
---

<div class="gate" id="post-gate">
  <svg class="gate-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <rect x="4" y="11" width="16" height="9" rx="2" />
    <path d="M8 11V7a4 4 0 0 1 8 0v4" />
  </svg>

  <p class="gate-title">비밀번호로 보호된 글입니다</p>
  <p class="gate-hint">비밀번호를 입력하면 내용을 볼 수 있어요.</p>

  <form class="gate-form" id="post-gate-form">
    <input
      class="gate-input"
      id="post-gate-password"
      type="password"
      autocomplete="off"
      placeholder="비밀번호"
      aria-label="글 비밀번호"
    />
    <button class="gate-submit" type="submit">확인</button>
  </form>

  <p class="gate-error" id="post-gate-error" hidden>비밀번호가 올바르지 않습니다.</p>
</div>

<script
  define:vars={{
    salt: payload.salt,
    iv: payload.iv,
    ciphertext: payload.ciphertext,
    iterations: PBKDF2_ITERATIONS,
  }}
>
  const gate = document.getElementById('post-gate');
  const form = document.getElementById('post-gate-form');
  const input = document.getElementById('post-gate-password');
  const errorEl = document.getElementById('post-gate-error');

  function base64ToBytes(base64) {
    return Uint8Array.from(atob(base64), (c) => c.charCodeAt(0));
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl.hidden = true;

    // Looked up lazily (not at module scope) because this script — like any
    // define:vars script — runs inline as the parser reaches it, before it
    // has parsed the sibling #post-gate-content div that comes after it.
    const content = document.getElementById('post-gate-content');

    try {
      const keyMaterial = await crypto.subtle.importKey(
        'raw',
        new TextEncoder().encode(input.value),
        'PBKDF2',
        false,
        ['deriveKey'],
      );
      const key = await crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt: base64ToBytes(salt), iterations, hash: 'SHA-256' },
        keyMaterial,
        { name: 'AES-GCM', length: 256 },
        false,
        ['decrypt'],
      );
      const decrypted = await crypto.subtle.decrypt(
        { name: 'AES-GCM', iv: base64ToBytes(iv) },
        key,
        base64ToBytes(ciphertext),
      );

      content.innerHTML = new TextDecoder().decode(decrypted);
      gate.hidden = true;
      content.hidden = false;
    } catch {
      // A wrong password fails the AES-GCM auth tag check and lands here —
      // there's no separate "check the password" step to get wrong.
      errorEl.hidden = false;
      input.value = '';
      input.focus();
    }
  });
</script>

<style>
  .gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface-muted);
    padding: clamp(2.5rem, 6vw, 3.5rem) 1.5rem;
    text-align: center;
  }

  /* `display: flex` above otherwise beats the UA [hidden] rule at equal
     specificity, since author styles always win over the UA stylesheet. */
  .gate[hidden] {
    display: none;
  }

  .gate-icon {
    width: 1.75rem;
    height: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--muted);
  }

  .gate-title {
    margin: 0;
    color: var(--text);
    font-weight: 700;
  }

  .gate-hint {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .gate-form {
    display: flex;
    gap: 0.5rem;
    width: 100%;
    max-width: 18rem;
  }

  .gate-input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--text);
    font-size: 0.95rem;
    padding: 0.55rem 0.8rem;
  }

  .gate-input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .gate-submit {
    border: 1px solid var(--text);
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.55rem 1rem;
    cursor: pointer;
    transition: opacity 160ms ease;
  }

  .gate-submit:hover,
  .gate-submit:focus-visible {
    opacity: 0.85;
  }

  .gate-error {
    margin: 0.25rem 0 0;
    color: var(--text);
    font-size: 0.85rem;
  }
</style>
