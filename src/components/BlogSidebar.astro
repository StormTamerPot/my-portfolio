---
import { SITE_CONFIG } from '../config/site';
import type { BlogPost } from '../utils/blog';

interface Props {
  posts: BlogPost[];
  activeCategory: string;
}

const { posts, activeCategory } = Astro.props;

const categories = SITE_CONFIG.blogCategories.map((category) => ({
  id: category.id,
  label: category.label,
  href: category.id === 'all' ? '/blog' : `/blog/category/${category.id}/`,
  count:
    category.id === 'all'
      ? posts.length
      : posts.filter((post) => post.category === category.id).length,
}));
---

<aside class="blog-sidebar" aria-label="블로그 카테고리">
  <p class="sidebar-heading">Categories</p>

  <nav class="sidebar-nav">
    {
      categories.map((category) => (
        <a
          href={category.href}
          class:list={['sidebar-link', { active: category.id === activeCategory }]}
          aria-current={category.id === activeCategory ? 'page' : undefined}
        >
          <span class="sidebar-label">{category.label}</span>
          <span class="sidebar-count">{category.count}</span>
        </a>
      ))
    }
  </nav>
</aside>

<style>
  .blog-sidebar {
    align-self: start;
    padding-top: 0.25rem;
  }

  .sidebar-heading {
    margin: 0 0 0.9rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-left: 2px solid transparent;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 600;
    padding: 0.55rem 0 0.55rem 0.85rem;
    text-decoration: none;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .sidebar-link:hover,
  .sidebar-link:focus-visible {
    color: var(--text);
  }

  .sidebar-link.active {
    border-left-color: var(--accent);
    color: var(--text);
  }

  .sidebar-count {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .sidebar-link.active .sidebar-count {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .blog-sidebar {
      border-bottom: 1px solid var(--line);
      padding-bottom: 1.25rem;
    }

    .sidebar-nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .sidebar-link {
      border-left: none;
      border: 1px solid var(--line);
      border-radius: 999px;
      gap: 0.4rem;
      padding: 0.45rem 0.8rem;
    }

    .sidebar-link.active {
      border-color: var(--text);
      background: var(--text);
      color: #ffffff;
    }

    .sidebar-link.active .sidebar-count {
      color: #ffffff;
    }
  }
</style>
