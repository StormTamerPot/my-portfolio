---
import { SITE_CONFIG } from '../../config/site';

const { profile, links, navigation } = SITE_CONFIG;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="footer-name" href="/">{profile.name}</a>
      </div>

      <div class="footer-columns">
        <nav class="footer-nav" aria-label="푸터 메뉴">
          <p class="footer-heading">Menu</p>
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>

        <div class="footer-social">
          <p class="footer-heading">Connect</p>
          <a href={links.github} target="_blank" rel="noreferrer">GitHub</a>
          <a href={`mailto:${profile.email}`}>Email</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {currentYear} {profile.name}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 0;
    border-top: 1px solid var(--line);
    background: var(--surface-muted);
    color: var(--text-secondary);
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  /* Light theme only: classic navy footer, visually distinct from the
     white page above it. Dark theme keeps the default surface-muted
     footer defined above. Overriding the tokens here (rather than every
     individual rule) lets every existing footer rule below pick up the
     navy palette automatically. */
  :root[data-theme="light"] .site-footer {
    --surface-muted: #0f1b3d;
    --text: #f5f7fb;
    --text-secondary: #c3cbe0;
    --muted: #92a0c4;
    --line: #24345c;
  }

  .footer-inner {
    width: min(100% - 4rem, var(--page-width));
    margin: 0 auto;
    padding: clamp(1.1rem, 2vw, 1.4rem) 0 clamp(0.7rem, 1.4vw, 0.9rem);
  }

  .footer-main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.5rem;
    padding-bottom: 0.9rem;
  }

  .footer-brand {
    max-width: 22rem;
  }

  .footer-name {
    display: inline-block;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .footer-columns {
    display: flex;
    gap: 3.5rem;
  }

  .footer-heading {
    margin: 0 0 0.4rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .footer-nav,
  .footer-social {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .footer-nav a,
  .footer-social a {
    width: fit-content;
    color: var(--text-secondary);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .footer-nav a:hover,
  .footer-nav a:focus-visible,
  .footer-social a:hover,
  .footer-social a:focus-visible {
    color: var(--text);
  }

  .footer-bottom {
    border-top: 1px solid var(--line);
    padding-top: 0.5rem;
  }

  .footer-bottom p {
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
  }

  @media (max-width: 38rem) {
    .footer-inner {
      width: min(100% - 2rem, var(--page-width));
    }

    .footer-main {
      flex-direction: column;
      gap: 1rem;
      padding-bottom: 1rem;
    }

    .footer-columns {
      gap: 2.5rem;
    }
  }
</style>
