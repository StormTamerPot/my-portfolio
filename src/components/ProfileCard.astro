---
import { SITE_CONFIG } from '../config/site';

const { profile, links } = SITE_CONFIG;
---

<section class="profile-hero">
  <img
    class="profile-avatar"
    src={profile.image}
    alt={`${profile.name} 프로필 사진`}
  />

  <div class="profile-content">
    {/* profile.label / profile.role are disabled for now — re-add here when needed. */}
    <div class="profile-description">
      {profile.description.map((paragraph) => <p set:html={paragraph} />)}
    </div>

    <div class="profile-contacts">
      <a class="contact-pill" href={links.github} target="_blank" rel="noreferrer">
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <a class="contact-pill" href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
  </div>
</section>

<style>
  .profile-hero {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    max-width: 58rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3.5rem, 7vw, 5rem);
    text-align: left;
  }

  .profile-avatar {
    flex-shrink: 0;
    width: 4.5rem;
    height: 4.5rem;
    margin-top: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
  }

  .profile-content {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    min-width: 0;
  }

  .profile-description {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .profile-description p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.85;
  }

  .profile-description :global(strong) {
    color: var(--text);
    font-weight: 700;
  }

  .profile-description :global(u) {
    color: var(--text);
    font-weight: 600;
    text-decoration-color: var(--text);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .profile-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.25rem;
  }

  @media (max-width: 40rem) {
    .profile-hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 2.5rem 0 3.5rem;
    }

    .profile-avatar {
      width: 4rem;
      height: 4rem;
      margin-top: 0;
    }
  }
</style>
