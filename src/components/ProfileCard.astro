---
import { SITE_CONFIG } from '../config/site';

const { profile, links } = SITE_CONFIG;
---

<section class="profile-hero">
  <img
    class="profile-avatar"
    src={profile.image}
    alt={`${profile.name} 프로필 사진`}
  />

  <p class="profile-label">{profile.label}</p>

  <h1>{profile.name}</h1>

  <span class="profile-role">{profile.role}</span>

  <div class="profile-description">
    {profile.description.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <div class="profile-contacts">
    <a class="contact-pill" href={links.github} target="_blank" rel="noreferrer">
      GitHub <span aria-hidden="true">↗</span>
    </a>
    <a class="contact-pill" href={`mailto:${profile.email}`}>{profile.email}</a>
  </div>
</section>

<style>
  .profile-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 36rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3.5rem, 7vw, 5rem);
    text-align: center;
  }

  .profile-avatar {
    width: 4.75rem;
    height: 4.75rem;
    margin-bottom: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    object-fit: cover;
    object-position: center top;
  }

  .profile-label {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .profile-hero h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(2.6rem, 5.4vw, 3.75rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .profile-role {
    display: inline-block;
    margin-top: 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding: 0.4rem 0.9rem;
  }

  .profile-description {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .profile-description p {
    max-width: 32rem;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.85;
  }

  .profile-contacts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  @media (max-width: 46rem) {
    .profile-hero {
      padding: 2.5rem 0 3.5rem;
    }

    .profile-avatar {
      width: 4rem;
      height: 4rem;
      margin-bottom: 1.5rem;
    }
  }
</style>
