---
import type { BlogPost } from '../utils/blog';
import { formatDate } from '../utils/formatDate';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<a class="post-row" href={post.href}>
  <div class="post-meta">
    <span>{post.categoryLabel}</span>
    <time datetime={post.entry.data.pubDate.toISOString()}>
      {formatDate(post.entry.data.pubDate)}
    </time>
  </div>

  <div class="post-content">
    <h2>{post.entry.data.title}</h2>
    <p>{post.entry.data.description}</p>
  </div>
</a>

<style>
  .post-row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    border-bottom: 1px solid var(--line);
    color: inherit;
    padding: 1.5rem 0;
    text-decoration: none;
    transition: background 180ms ease, padding 180ms ease;
  }

  .post-row:hover {
    background: var(--surface-muted);
    padding-right: 1rem;
    padding-left: 1rem;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--muted);
    font-size: 0.77rem;
  }

  .post-meta span {
    color: var(--accent);
    font-weight: 700;
  }

  .post-content h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    letter-spacing: -0.04em;
    line-height: 1.35;
    word-break: keep-all;
  }

  .post-row:hover .post-content h2 {
    color: var(--accent);
  }

  .post-content p {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.7;
    word-break: keep-all;
  }

  @media (max-width: 640px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .post-meta {
      flex-direction: row;
      gap: 0.7rem;
    }
  }
</style>
